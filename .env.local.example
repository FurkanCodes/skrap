

# Supabase Postgres (pooler) connection for tracking DB
# Example format:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
TRACKING_DATABASE_URL=postgresql://postgres.soobhrpchrfhbxqdshub:g8bnns0fGMGVz4WZ@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Optional pool tuning
TRACKING_DB_POOL_MIN_SIZE=1
TRACKING_DB_POOL_MAX_SIZE=10

# Scheduler / notifier tuning for lockstep checks
SCHEDULER_POLL_SECONDS=1
SCHEDULER_JITTER_PERCENT=0
SCHEDULER_ALIGN_CHECKS_TO_INTERVAL=true
NOTIFIER_POLL_SECONDS=1

# API auth (Better Auth JWT verification)
