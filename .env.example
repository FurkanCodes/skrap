# Supabase Postgres (pooler) connection for tracking DB
# Example format:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
TRACKING_DATABASE_URL=

# Optional pool tuning
TRACKING_DB_POOL_MIN_SIZE=1
TRACKING_DB_POOL_MAX_SIZE=10

# Scheduler / notifier tuning
SCHEDULER_POLL_SECONDS=10
SCHEDULER_JITTER_PERCENT=10
SCHEDULER_ALIGN_CHECKS_TO_INTERVAL=false
SCHEDULER_QUEUE_REDIS_URL=redis://127.0.0.1:6379/0
SCHEDULER_QUEUE_STREAM_KEY=tracking:scheduler:jobs
SCHEDULER_QUEUE_CONSUMER_GROUP=tracking-scheduler-workers
SCHEDULER_QUEUE_MAX_STREAM_LENGTH=1000000
SCHEDULER_WORKER_CLAIM_BATCH_SIZE=64
SCHEDULER_WORKER_BLOCK_SECONDS=5
SCHEDULER_WORKER_PENDING_IDLE_SECONDS=60
NOTIFIER_POLL_SECONDS=5
NOTIFIER_MAX_INFLIGHT=16
TELEGRAM_SENDER_MIN_INTERVAL_MS=50

# API auth (Better Auth JWT verification)
AUTH_REQUIRED=true
BETTER_AUTH_JWKS_URL=
BETTER_AUTH_JWT_ISSUER=
BETTER_AUTH_JWT_AUDIENCE=
BETTER_AUTH_JWKS_CACHE_TTL_SECONDS=300

# Perf tracing (optional)
# Logs spans for service/repository/auth calls at/above PERF_SLOW_MS.
PERF_TRACE_ENABLED=false
PERF_SLOW_MS=100

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CONNECT_TTL_MINUTES=15

# Affiliate link rendering in Telegram alerts.
# If empty: direct product URL is sent.
# If contains {url}: encoded product URL will replace it.
# Otherwise `?url=<encoded>` (or `&url=`) is appended.
AFFILIATE_LINK_TEMPLATE=
